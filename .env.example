# ---------------------------------------------------------------------------
# Public frontend configuration.
# These values are inlined into the browser bundle and must be PUBLIC-safe.
# Never put the Supabase service-role key, Resend API key, or any other
# secret here. Secrets belong only in Supabase Edge Function secrets.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe for browsers; access is governed by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical production URL. Must NOT include a /SpudChallenge base path.
NEXT_PUBLIC_SITE_URL=https://spudchallenge.online

# Meta Pixel ID for consent-gated advertising measurement (prompt 40).
# Public by design; leave empty to disable the Meta Pixel entirely.
# NEVER put META_CAPI_ACCESS_TOKEN here — it belongs only in Supabase
# Edge Function secrets.
NEXT_PUBLIC_META_PIXEL_ID=
